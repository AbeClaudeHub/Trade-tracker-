rules_version = '2';

// Niyyah OS — Firestore security rules (v3).
// A user owns their profile and their single generated report. License codes
// are issued by the community owner and redeemed once.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /report/{doc} { allow read, write: if isOwner(uid); }
    }

    match /licenseCodes/{code} {
      // Anyone signed in may check a code to redeem it.
      allow read: if isSignedIn();
      // A code can only be claimed if unused, and only by the claimer.
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.usedBy == request.auth.uid;
      // Codes are seeded by the owner (Firebase console / admin); no client create/delete.
      allow create, delete: if false;
    }
  }
}
